#include<iostream>
using namespace std;

bool rev(int a){

int temp=a;
int rem = 0;
while(a>0){
int r = a%10;
 rem = rem*10+r;
 a=a/10;
}
return temp==rem;
}

int main(){
int a;
cout<<"Enter values\n";
cin>>a;
if(rev(a)){
    cout<<"given no is palindrome";
}
else{
    cout<<"No a palindrome";
}

return 0;
}

